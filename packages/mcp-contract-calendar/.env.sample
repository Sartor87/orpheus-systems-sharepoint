# Server
PORT=8787
# Auth: none (local dev only) or the real token validation mode
AUTH_MODE=none
# Data: local (in-memory/fixtures) or sharepoint
DATA_MODE=local
# Acting user id when AUTH_MODE=none
LOCAL_USER_ID=1
# SharePoint site and app registration
SITE_URL=https://<tenant>.sharepoint.com/sites/<site>
TENANT_ID=<tenant-id>
CLIENT_ID=<client-id>
CLIENT_SECRET=<client-secret>
# Expected audience of incoming tokens and the scope used for SharePoint calls
API_AUDIENCE=api://<app-id-uri>
SP_SCOPE=https://<tenant>.sharepoint.com/AllSites.Write
# List URLs (site-relative)
CONTRACTS_LIST_URL=Lists/Contracts
ENTRIES_LIST_URL=Lists/CalendarEntries
HOLIDAYS_LIST_URL=Lists/Holidays
# HR role: members of this SharePoint group get HR permissions
HR_GROUP=Orpheus HR
# Diagnostics
AUDIT_LOG_PATH=
LOG_REQUEST_HEADERS=false
