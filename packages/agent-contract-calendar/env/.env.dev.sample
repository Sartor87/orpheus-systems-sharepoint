# Copy to .env.dev (gitignored) and fill in. Never commit real values.
TEAMS_APP_ID=<teams-app-guid-created-by-provision>
MCP_SERVER_URL=https://<dev-tunnel-host>/mcp
MCP_AUTH_REFERENCE_ID=<entra-sso-auth-config-id>
# Appended as-is to "Contract Calendar"; keep the leading space and the quotes.
APP_NAME_SUFFIX=" (dev)"
# Public pages shown in the app details: PRIVACY.md and TERMS.md of this package on the hosting repo.
PRIVACY_URL=https://github.com/<owner>/<repo>/blob/main/packages/agent-contract-calendar/PRIVACY.md
TERMS_URL=https://github.com/<owner>/<repo>/blob/main/packages/agent-contract-calendar/TERMS.md
