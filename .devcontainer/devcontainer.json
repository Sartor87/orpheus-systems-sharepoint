{
  "name": "Orpheus SPFx",
  "image": "docker.io/m365pnp/spfx:1.23.2",
  "workspaceFolder": "/usr/app/spfx",
  "containerUser": "node",
  "remoteUser": "node",
  "workspaceMount": "source=${localWorkspaceFolder},target=/usr/app/spfx,type=bind",
  "mounts": [
    "source=nm-root,target=/usr/app/spfx/node_modules,type=volume",
    "source=nm-shared-core,target=/usr/app/spfx/packages/shared-core/node_modules,type=volume",
    "source=nm-shared-ui,target=/usr/app/spfx/packages/shared-ui/node_modules,type=volume",
    "source=nm-wp-contract-calendar,target=/usr/app/spfx/packages/wp-contract-calendar/node_modules,type=volume"
  ],
  "forwardPorts": [4321, 35729],
  "postCreateCommand": "npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "orta.vscode-jest"
      ]
    }
  }
}
